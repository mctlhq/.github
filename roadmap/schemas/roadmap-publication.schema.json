{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mctl.ai/schemas/roadmap/roadmap-publication-v1alpha1.json",
  "title": "RoadmapPublication",
  "description": "Provenance for one published roadmap answer: which evaluator and manifests produced it, from which single observation, and the digests of the files it covers. Consumers read this before trusting ready-set.json or health.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "evaluator", "source", "manifests", "observation", "files"],
  "properties": {
    "apiVersion": {"const": "roadmap.mctl.ai/v1alpha1"},
    "kind": {"const": "RoadmapPublication"},
    "evaluator": {
      "description": "The revision of the evaluator code (roadmap/scripts) that produced the derived files.",
      "type": "object",
      "additionalProperties": false,
      "required": ["revision"],
      "properties": {"revision": {"$ref": "#/$defs/revision"}}
    },
    "source": {
      "description": "Where the manifests were read from. The manifests remain the planning source of truth; this publication is derived state.",
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "ref", "revision"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "ref": {"type": "string", "minLength": 1},
        "revision": {"$ref": "#/$defs/revision"}
      }
    },
    "manifests": {
      "description": "Every EpicDefinition the publication covers, with the digest of the exact bytes that were validated.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "epic"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"$ref": "#/$defs/sha256"},
          "epic": {
            "description": "The epic's identity and lifecycle, copied from the manifest these digests cover.",
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "lifecycle", "title", "goal"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "lifecycle": {"enum": ["proposed", "active", "paused", "completed", "archived"]},
              "title": {"type": "string", "minLength": 1},
              "goal": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "observation": {
      "description": "The single observation everything is derived from, copied from snapshot.json. Freshness is capturedAt; a synthetic observation carries none and is never fresh.",
      "type": "object",
      "oneOf": [
        {
          "additionalProperties": false,
          "required": ["mode", "capturedAt", "apiBase"],
          "properties": {
            "mode": {"const": "live-capture"},
            "capturedAt": {"type": "string", "format": "date-time"},
            "apiBase": {"type": "string", "minLength": 1}
          }
        },
        {
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {"mode": {"const": "synthetic-fixture"}}
        }
      ]
    },
    "files": {
      "description": "Digests of the files this publication covers.",
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot.json", "ready-set.json", "health.json"],
      "properties": {
        "snapshot.json": {"$ref": "#/$defs/digest"},
        "ready-set.json": {"$ref": "#/$defs/digest"},
        "health.json": {"$ref": "#/$defs/digest"}
      }
    }
  },
  "$defs": {
    "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256"],
      "properties": {"sha256": {"$ref": "#/$defs/sha256"}}
    }
  }
}
