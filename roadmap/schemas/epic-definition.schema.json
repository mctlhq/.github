{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mctl.ai/schemas/roadmap/epic-definition-v1alpha1.json",
  "title": "roadmap.mctl.ai/v1alpha1 EpicDefinition",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "roadmap.mctl.ai/v1alpha1"},
    "kind": {"const": "EpicDefinition"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "owner"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$",
          "minLength": 1,
          "maxLength": 63
        },
        "owner": {"type": "string", "minLength": 1},
        "labels": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "goal", "lifecycle", "github", "phases", "workItems", "completion", "successCriteria"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "goal": {"type": "string", "minLength": 1},
        "lifecycle": {"enum": ["proposed", "active", "paused", "completed", "archived"]},
        "github": {
          "type": "object",
          "additionalProperties": false,
          "required": ["issue"],
          "properties": {
            "issue": {"$ref": "#/$defs/issueRef"},
            "issueType": {"type": "string", "minLength": 1},
            "project": {
              "type": "object",
              "additionalProperties": {"type": ["string", "number", "boolean", "null"]}
            }
          }
        },
        "phases": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/phase"}
        },
        "workItems": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/workItem"}
        },
        "completion": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {"mode": {"const": "allRequired"}}
        },
        "successCriteria": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "issueRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "number"],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*/[A-Za-z0-9._-]+$"
        },
        "number": {"type": "integer", "minimum": 1}
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title"],
      "properties": {
        "id": {"$ref": "#/$defs/localId"},
        "title": {"type": "string", "minLength": 1}
      }
    },
    "workItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "phase", "required"],
      "properties": {
        "id": {"$ref": "#/$defs/localId"},
        "title": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "phase": {"$ref": "#/$defs/localId"},
        "required": {"type": "boolean"},
        "issue": {"$ref": "#/$defs/issueRef"},
        "parent": {"$ref": "#/$defs/localId"},
        "dependsOn": {
          "type": "array",
          "items": {"$ref": "#/$defs/localId"},
          "uniqueItems": true
        },
        "externalDependsOn": {
          "type": "array",
          "items": {"$ref": "#/$defs/issueRef"},
          "uniqueItems": true
        }
      }
    },
    "localId": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$",
      "minLength": 1,
      "maxLength": 63
    }
  }
}
